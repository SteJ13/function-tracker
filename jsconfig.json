{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // "@/*": [
      //   "src/*"
      // ],
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@globalConstant": [
        "src/globalConstant.js"
      ]
    }
  },
  "include": [
    "src"
  ]
}